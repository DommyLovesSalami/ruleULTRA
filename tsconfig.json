{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "node",
    "verbatimModuleSyntax": true,
    "declaration": false,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "lib": ["DOM", "ES6", "DOM.Iterable", "ScriptHost", "ESNext"],
    "types": ["node"]
  },
  "include": ["src/**/*"]
}
